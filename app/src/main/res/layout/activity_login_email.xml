<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cr_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <TextView
            android:text="@string/Txt_login"
            android:textStyle="bold"
            android:textSize="22sp"
            android:letterSpacing="0.1"
            android:textColor="@color/cr_texto_primario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp" />

        <TextView
            android:text="Ingresa tus credenciales"
            android:textColor="@color/cr_texto_secundario"
            android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp" />

        <!-- EMAIL FIELD -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:boxStrokeColor="@color/cr_acento"
            app:hintTextColor="@color/cr_acento"
            app:boxBackgroundColor="@color/cr_superficie"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            android:textColorHint="@color/cr_texto_secundario"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/Et_email"
                android:hint="@string/Et_email"
                android:inputType="textEmailAddress"
                android:textColor="@color/cr_texto_primario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- PASSWORD FIELD -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            app:boxStrokeColor="@color/cr_acento"
            app:hintTextColor="@color/cr_acento"
            app:boxBackgroundColor="@color/cr_superficie"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/cr_acento"
            android:textColorHint="@color/cr_texto_secundario"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/Et_password"

                android:hint="@string/Et_password"
                android:inputType="textPassword"
                android:textColor="@color/cr_texto_primario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- LOGIN BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/Btn_ingresar"
            android:text="@string/Btn_ingresar"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/cr_fondo"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            app:backgroundTint="@color/cr_acento"
            app:cornerRadius="14dp" />

        <!-- REGISTER LINK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <TextView
                android:text="@string/Txt_no_cuenta"
                android:textColor="@color/cr_texto_secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/Txt_registrarme"
                android:text="@string/Txt_registrarme"
                android:textStyle="bold"
                android:textColor="@color/cr_acento"
                android:layout_marginStart="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>