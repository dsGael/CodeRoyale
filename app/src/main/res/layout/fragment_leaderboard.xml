<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cr_beige_carta"
    tools:context=".Fragmentos.FragmentLeaderboard">

    <RelativeLayout
        android:id="@+id/RL_top_ranking"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@color/cr_azul_rey">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="CLASIFICACIÓN"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="18sp" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="15dp"
            android:src="@drawable/flame"
            app:tint="@color/cr_dorado_brillante"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"
            android:background="@color/cr_dorado" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/LL_banner_liga"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/RL_top_ranking"
        android:background="@color/cr_azul_oscuro"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="15dp">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/flame"
            app:tint="@color/cr_dorado"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="LIGA RUBÍ"
            android:textColor="@color/cr_dorado_brillante"
            android:textStyle="bold"
            android:textSize="20sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Termina en 2 días 4 horas"
            android:textColor="@android:color/white"
            android:textSize="12sp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/Rv_leaderboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/LL_banner_liga"
        android:layout_marginBottom="90dp"
        android:paddingTop="10dp"
        android:clipToPadding="false"
        tools:listitem="@layout/item_ranking" />

</RelativeLayout>