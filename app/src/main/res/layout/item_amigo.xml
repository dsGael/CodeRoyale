<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical">

    <!-- AVATAR -->
    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/login"
        android:padding="2dp"
        app:strokeColor="@color/cr_acento"
        app:strokeWidth="2dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent" />

    <!-- INFO -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">


        <TextView
            android:id="@+id/Txt_nombre_amigo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ana Pythonisa"
            android:textStyle="bold"
            android:textColor="@color/cr_blanco"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/experiencia"
                app:tint="@color/cr_acento" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="3450 EXP"
                android:textSize="12sp"
                android:textColor="@color/cr_texto_secundario" />
        </LinearLayout>
    </LinearLayout>

    <!-- CHALLENGE BUTTON -->
    <com.google.android.material.button.MaterialButton
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="RETAR"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/cr_fondo"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:backgroundTint="@color/cr_acento"
        app:cornerRadius="10dp" />

</LinearLayout>