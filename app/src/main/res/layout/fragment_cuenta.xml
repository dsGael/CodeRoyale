<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cr_fondo"
    tools:context=".Fragmentos.FragmentCuenta">

    <!-- TOP BAR -->
    <RelativeLayout
        android:id="@+id/RL_top"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/cr_superficie">

        <TextView
            android:id="@+id/Txt_nombre_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="MI CUENTA"
            android:textColor="@color/cr_texto_primario"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textSize="16sp" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:src="@drawable/experiencia"
            app:tint="@color/cr_acento" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"
            android:background="@color/cr_divisor" />
    </RelativeLayout>

    <!-- SCROLL CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/RL_top"
        android:layout_marginBottom="90dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HERO / AVATAR -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@color/cr_hero_bg">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_alignParentBottom="true"
                    android:background="@color/cr_acento" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/Iv_perfil"
                    android:layout_width="118dp"
                    android:layout_height="118dp"
                    android:layout_centerInParent="true"
                    android:layout_marginBottom="36dp"
                    android:padding="3dp"
                    android:src="@drawable/login"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent"
                    app:strokeColor="@color/cr_acento"
                    app:strokeWidth="3dp" />

                <TextView
                    android:id="@+id/Txt_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/Iv_perfil"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="10dp"
                    android:text="jorgedr12"
                    android:textColor="@color/cr_blanco"
                    android:textSize="15sp"
                    android:letterSpacing="0.05"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- NIVEL Y PROGRESO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/cr_superficie"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Nivel 12 — Intermedio"
                        android:textColor="@color/cr_texto_primario"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7836 / 10000 XP"
                        android:textColor="@color/cr_acento"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:progress="78"
                    android:max="100"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:background="@color/cr_divisor" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="2164 XP para el siguiente nivel"
                    android:textColor="@color/cr_texto_secundario"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp">

                <!-- ESTADÍSTICAS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESTADÍSTICAS"
                    android:textColor="@color/cr_texto_secundario"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/flame"
                            app:tint="@color/cr_fuego" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="1"
                            android:textColor="@color/cr_texto_primario"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="día de racha"
                            android:textColor="@color/cr_texto_secundario"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp"
                        android:layout_marginStart="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/experiencia"
                            app:tint="@color/cr_acento" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="7836"
                            android:textColor="@color/cr_texto_primario"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="experiencia"
                            android:textColor="@color/cr_texto_secundario"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_ejercicios"
                            app:tint="@color/cr_acento" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="124"
                            android:textColor="@color/cr_texto_primario"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ejercicios"
                            android:textColor="@color/cr_texto_secundario"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp"
                        android:layout_marginStart="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/experiencia"
                            app:tint="@color/cr_fuego" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="87%"
                            android:textColor="@color/cr_texto_primario"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="precisión"
                            android:textColor="@color/cr_texto_secundario"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- INFORMACIÓN PERSONAL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INFORMACIÓN"
                    android:textColor="@color/cr_texto_secundario"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp">

                    <!-- Nombres -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/Txt_nombres"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/Txt_nombres"
                            android:textColor="@color/cr_texto_secundario"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/Tv_nombres"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Tv_nombres"
                            android:textColor="@color/cr_texto_primario"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/cr_divisor"/>

                    <!-- Email -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/Txt_email"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/Txt_email"
                            android:textColor="@color/cr_texto_secundario"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/Tv_email"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Tv_email"
                            android:textColor="@color/cr_texto_primario"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/cr_divisor"/>

                    <!-- Fecha de nacimiento -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/Txt_nacimiento"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/Txt_nacimiento"
                            android:textColor="@color/cr_texto_secundario"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/Tv_nacimiento"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Tv_nacimiento"
                            android:textColor="@color/cr_texto_primario"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/cr_divisor"/>

                    <!-- Miembro desde -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/Txt_miembro"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/Txt_miembro"
                            android:textColor="@color/cr_texto_secundario"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/Tv_miembro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Tv_miembro"
                            android:textColor="@color/cr_texto_primario"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/cr_divisor"/>

                    <!-- Teléfono -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/Txt_telefono"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/Txt_telefono"
                            android:textColor="@color/cr_texto_secundario"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/Tv_telefono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Tv_telefono"
                            android:textColor="@color/cr_texto_primario"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/cr_divisor"/>

                    <!-- Estado de cuenta -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/Txt_estado_cuenta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/Txt_estado_cuenta"
                            android:textColor="@color/cr_texto_secundario"
                            android:textSize="13sp" />

                        <!-- Chip de estado -->
                        <TextView
                            android:id="@+id/Tv_estado_cuenta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Tv_estado_cuenta"
                            android:textColor="@color/cr_fuego"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- LOGROS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOGROS RECIENTES"
                    android:textColor="@color/cr_texto_secundario"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="🔥"
                        android:textSize="22sp"
                        android:background="@color/cr_hero_bg" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Primera racha"
                            android:textColor="@color/cr_texto_primario"
                            android:textStyle="bold"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Completaste 7 días seguidos"
                            android:textColor="@color/cr_texto_secundario"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+50 XP"
                        android:textColor="@color/cr_acento"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="💻"
                        android:textSize="22sp"
                        android:background="@color/cr_hero_bg" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100 ejercicios"
                            android:textColor="@color/cr_texto_primario"
                            android:textStyle="bold"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Completaste 100 retos de código"
                            android:textColor="@color/cr_texto_secundario"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+100 XP"
                        android:textColor="@color/cr_acento"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- OPCIONES -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OPCIONES"
                    android:textColor="@color/cr_texto_secundario"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/Btn_editar_perfil"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/Btn_editar_perfil"
                    android:textColor="@color/cr_fondo"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    app:icon="@drawable/ic_editar"
                    app:iconTint="@color/cr_fondo"
                    app:backgroundTint="@color/cr_acento"
                    app:cornerRadius="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/cr_divisor" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/Btn_logout"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/Btn_cerrar_sesion"
                    android:textColor="@color/cr_peligro"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    app:icon="@drawable/ic_salir"
                    app:iconTint="@color/cr_peligro"
                    app:strokeColor="@color/cr_peligro"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>